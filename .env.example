# =============================================================================
# Environment variables template.
# Copy this file to .env and fill in your own values.
# =============================================================================

# --- HuggingFace cache (optional) ---
HF_HOME=./hf_cache
HF_ENDPOINT=https://hf-mirror.com

# --- API keys for GPT / Gemini (OpenAI-compatible proxy) ---
DMX_API_KEY=your_api_key_here
DMX_BASE_URL=https://www.dmxapi.cn/v1

# --- Data paths (relative to project root) ---
DATASET_ROOT=./data
OUTPUT_ROOT=./results
ATTENTION_DATA_ROOT=./data
ATTENTION_OUTPUT_ROOT=./results/attention_maps